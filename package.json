{
  "name": "syncstream",
  "version": "1.0.0",
  "private": true,
  "description": "Scalable real-time watch party platform",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:server": "turbo run build --filter=@syncstream/server",
    "build:extension": "turbo run build --filter=@syncstream/extension",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "prettier": "^3.3.0",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.4.0"
}
